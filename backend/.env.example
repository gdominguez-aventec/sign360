# --- General ---
SECRET_KEY=canvia-aquesta-clau
DEBUG=True
ENV=local
LANGUAGE=ca
TIME_ZONE=Europe/Madrid
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=True

# --- Base de dades ---
DATABASE_NAME=app_aqua360_sign
DATABASE_USER=app_aqua360_sign
DATABASE_PASSWORD=app_aqua360_sign
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Emmagatzematge de documents ---
# Arrel on es desen els fitxers (per defecte, la carpeta del projecte)
DOCUMENT_MANAGER_PATH=
DOCUMENT_MAX_UPLOAD_SIZE=20971520

# Permet més d'un signant per sol·licitud (signatura encadenada).
# Desactivat de moment: amb False només s'admet un signant.
MULTI_SIGNER_ENABLED=False

# --- Certificat per al segellat opcional dels PDF (pyHanko) ---
PFX_PATH=
PFX_PASS=

# --- API externa de signatura (Aqua360 Sign) ---
SIGNING_BASE_URL=
SIGNING_API_KEY=
# URL pública d'aquest backend on el proveïdor enviarà el webhook
SIGNING_CALLBACK_URL=http://localhost:8000/signing/callback/
SIGNING_TIMEOUT=30
# Clau que ha d'arribar a la capçalera X-API-Key del callback (buida = sense validar)
SIGN_CALLBACK_API_KEY=
