[Unit]
Description=Sign360 backend (gunicorn)
After=network.target postgresql.service
Requires=sign360-backend.socket

[Service]
Type=notify
User=sign360
Group=www-data
WorkingDirectory=/var/www/sign360/backend
Environment="PATH=/var/www/sign360/backend/env/bin"
ExecStart=/var/www/sign360/backend/env/bin/gunicorn \
    --workers 3 \
    --timeout 300 \
    --bind unix:/run/sign360_backend.sock \
    --access-logfile /var/log/sign360/access.log \
    --error-logfile /var/log/sign360/error.log \
    sign360.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
